# Action-endpoint auth (lib/auth.ts). All three are secrets; never NEXT_PUBLIC_. Missing or too short
# = every protected action returns 503 (fail closed).
# Team password for /login (min 12 chars). Shared with teammates out of band, never in Slack.
DASHBOARD_PASSWORD=
# Signs the session cookie (min 32 chars), e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET=
# The buyer agent sends it as "Authorization: Bearer <key>" to POST /api/orders (min 32 chars, same generator).
AGENT_API_KEY=
