{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-check.mjs"],
            "timeout": 900,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
